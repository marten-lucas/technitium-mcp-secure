{
  "name": "technitium-mcp-secure-monorepo",
  "version": "1.2.4",
  "description": "MCP server for Technitium DNS Server management and diagnostics",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/full",
    "packages/diagnostic"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:analyse": "tsx watch src/index.ts --mode=analyse",
    "dev:full": "tsx watch src/index.ts --mode=full",
    "start": "node dist/index.js",
    "start:analyse": "node dist/index.js --mode=analyse",
    "start:full": "node dist/index.js --mode=full",
    "variant:full": "node packages/full/bin/technitium-mcp-full.mjs",
    "variant:diagnostic": "node packages/diagnostic/bin/technitium-mcp-diagnostic.mjs",
    "audit": "npm audit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
